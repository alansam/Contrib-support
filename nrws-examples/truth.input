say _ruler
ab = [[1, 1], [1, 0], [0, 1], [0, 0]];
_o = '\u2228'; --   OR: ∨ - U+2228 
no = '\u22bd'; --  NOR: ⊻ - U+22BD
xo = '\u22bb'; --  XOR: ⊻ - U+22BB
nd = '\u2227'; --  AND: ∧ - U+2227
nn = '\u22BC'; -- NAND: ⊼ - U+22BC
nt = '\u00ac'; --  NOT: ¬ - U+00AC
say 'truth table for OR  '; loop _e = 0 to ab.length - 1; lo = ab[_e]; say lo[0] _o lo[1] ':'   (lo[0] |  lo[1]);  end _e; say;
say 'truth table for NOR '; loop _e = 0 to ab.length - 1; lo = ab[_e]; say lo[0] no lo[1] ':' (\(lo[0] |  lo[1])); end _e; say;
say 'truth table for XOR '; loop _e = 0 to ab.length - 1; lo = ab[_e]; say lo[0] xo lo[1] ':'   (lo[0] && lo[1]);  end _e; say;
say 'truth table for AND '; loop _e = 0 to ab.length - 1; lo = ab[_e]; say lo[0] nd lo[1] ':'   (lo[0] &  lo[1]);  end _e; say;
say 'truth table for NAND'; loop _e = 0 to ab.length - 1; lo = ab[_e]; say lo[0] nn lo[1] ':' (\(lo[0] &  lo[1])); end _e; say;
say 'truth table for NOT '; loop _e = 0 to ab.length - 1 by 2; lo = ab[_e]; say nt||lo[0] ':'   (      \  lo[0]);  end _e; say;
